# Local Supabase direct PostgreSQL connection. Use the transaction pooler URL on Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-side only. Obtain from https://citoapi.com/signup.
CITO_API_KEY=

# Required for username/password authentication. The anon/publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional locally; required for public registration in production. Configure the matching
# Cloudflare Turnstile secret in Supabase Auth's CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trusted operator CLI only. Do not expose this value to the browser or add it to Vercel unless
# a server-side operation explicitly requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Integration tests are skipped unless this is set to a migrated disposable database.
TEST_DATABASE_URL=
