# Local Supabase direct PostgreSQL connection. Use the transaction pooler URL on Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-side only. Obtain from https://citoapi.com/signup.
CITO_API_KEY=

# Optional: only needed by future browser-side Supabase features.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integration tests are skipped unless this is set to a migrated disposable database.
TEST_DATABASE_URL=
